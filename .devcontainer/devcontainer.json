{
  "name": "housing-prediction",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Four services (two Python, one Java, one Next.js) fit comfortably on 4 cores.
  // Note: a 4-core Codespace uses the free monthly hours twice as fast as a 2-core one.
  "hostRequirements": { "cpus": 4 },

  // Once, when the Codespace is created: install dependencies and build the Java jar and the portal.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every time the Codespace starts or resumes: start all services.
  "postStartCommand": "bash .devcontainer/start-api.sh",

  "forwardPorts": [3000, 8000, 8001, 8080],
  "portsAttributes": {
    "3000": { "label": "Portal", "onAutoForward": "openBrowser" },
    "8000": { "label": "ML API (Swagger)", "onAutoForward": "silent" },
    "8001": { "label": "Estimator API (Swagger)", "onAutoForward": "silent" },
    "8080": { "label": "Market API (Swagger)", "onAutoForward": "silent" }
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "vscjava.vscode-java-pack", "bradlc.vscode-tailwindcss", "dbaeumer.vscode-eslint"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
