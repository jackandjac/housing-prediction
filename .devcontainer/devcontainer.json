{
  "name": "housing-prediction",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Install dependencies once when the Codespace is created...
  "postCreateCommand": "pip install --user -r ml-api/requirements-dev.txt",
  // ...and start the API every time the Codespace starts or resumes.
  "postStartCommand": "bash .devcontainer/start-api.sh",

  "forwardPorts": [8000, 9000],
  "portsAttributes": {
    "8000": { "label": "ML API (Swagger)", "onAutoForward": "openBrowser" },
    "9000": { "label": "Webhook receiver", "onAutoForward": "silent" }
  },

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/ml-api",
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
